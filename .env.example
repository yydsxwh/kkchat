# 复制为 .env 后填写。不要把真实密钥提交进 Git。
# 生产 origin。本地开发可保持下面的地址。
KKCHAT_ORIGIN=http://127.0.0.1:3210
PORT=3210

# PostgreSQL。不要改成 SQLite。
DATABASE_URL=postgresql://kkchat:kkchat@127.0.0.1:5432/kkchat

# 会话签名。至少 32 位随机字符串。留空则无法登录。
KKCHAT_SESSION_SECRET=

# 账号中心 OIDC。client secret 只放服务器环境，不要写进这个示例的值。
ACCOUNT_ISSUER=https://account.yydsxwh.com
ACCOUNT_CLIENT_ID=kkchat
ACCOUNT_CLIENT_SECRET=
ACCOUNT_REDIRECT_URI=http://127.0.0.1:3210/api/auth/callback
ACCOUNT_SCOPES=openid profile account.basic offline_access

# 服务端调用账号目录。浏览器不能使用这个 token。
ACCOUNT_INTERNAL_BASE_URL=https://account.yydsxwh.com
ACCOUNT_INTERNAL_TOKEN=

# 其它产品调用 KKChat 的服务凭证。浏览器不能使用。
KKCHAT_SERVICE_TOKEN=

# 可选。JSON：{"main":"...","academic":"..."}。配置后每个产品必须使用自己的凭证。
# KKCHAT_SERVICE_TOKENS=

# 主站，首页「返回网站首页」用。
MAIN_SITE_URL=https://www.yydsxwh.com

# 官方消息的微信提醒。不配置则只做站内实时，不报错。
# PLATFORM_BASE_URL=
# PLATFORM_SERVICE_TOKEN=

# 预留。不配置时使用进程内 realtime adapter。
# KKCHAT_REDIS_URL=

# 仅 https 部署时设为 true。本地 http 保持 false。
KKCHAT_COOKIE_SECURE=false

# ---- 原生 App（Android / iOS）----
# 账号中心登记的 public 客户端 ID（scripts/ensure-kkchat-native-clients.ts）。不是密钥。
# KKCHAT_ANDROID_CLIENT_ID=kkchat-android
# KKCHAT_IOS_CLIENT_ID=kkchat-ios
# 原生授权回调。默认 {KKCHAT_ORIGIN}/native/auth/callback，必须与账号中心登记的一致。
# KKCHAT_NATIVE_REDIRECT_URI=
# Android App Links：包名与正式签名证书 SHA-256 指纹（公开信息，可写多个，逗号分隔）。
# KKCHAT_ANDROID_PACKAGE=com.yydsxwh.kkchat
# KKCHAT_ANDROID_CERT_SHA256=
# iOS Universal Links：TEAMID.bundleId。没有 Apple Team ID 时留空，不发布关联文件。
# KKCHAT_IOS_APP_IDS=

# 聊天附件私有目录。生产放在 /var/lib/kkchat/attachments，并纳入备份。
# KKCHAT_ATTACHMENT_DIR=./data/attachments

# 举报审核人（账号中心 sub，逗号分隔）。账号中心 ADMIN 角色也可审核。
# KKCHAT_MODERATOR_SUBS=

# 部署时写入当前提交，健康检查会显示。
# KKCHAT_RELEASE_SHA=
