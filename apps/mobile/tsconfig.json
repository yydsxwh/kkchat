{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "resolveJsonModule": true,
    "paths": {
      "@shared/*": [
        "../../shared/*"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    "../../shared/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "android",
    "ios",
    "test"
  ]
}
